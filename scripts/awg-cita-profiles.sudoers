# Fixed profile commands. No shell or arbitrary path arguments.
Cmnd_Alias AWG_CITA_PROFILES = /usr/local/sbin/awg-cita-profile awg2 list, /usr/local/sbin/awg-cita-profile awg2 server, /usr/local/sbin/awg-cita-profile awg2 create, /usr/local/sbin/awg-cita-profile awg2 config peer-*, /usr/local/sbin/awg-cita-profile awg2 config-update peer-*, /usr/local/sbin/awg-cita-profile awg2 enable peer-*, /usr/local/sbin/awg-cita-profile awg2 disable peer-*, /usr/local/sbin/awg-cita-profile awg2 delete peer-*, /usr/local/sbin/awg-cita-profile wg list, /usr/local/sbin/awg-cita-profile wg server, /usr/local/sbin/awg-cita-profile wg create, /usr/local/sbin/awg-cita-profile wg config peer-*, /usr/local/sbin/awg-cita-profile wg config-update peer-*, /usr/local/sbin/awg-cita-profile wg enable peer-*, /usr/local/sbin/awg-cita-profile wg disable peer-*, /usr/local/sbin/awg-cita-profile wg delete peer-*
awg-manager ALL=(root) NOPASSWD: AWG_CITA_PROFILES
